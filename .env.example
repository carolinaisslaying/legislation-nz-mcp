# Your legislation.govt.nz developer API key.
# Request one at: https://www.legislation.govt.nz/learn-more/legislation-data/developer-api/
LEGISLATION_NZ_API_KEY=your_api_key_here

# Optional: RSS-only key for the legacy feed tools (search_legislation_rss,
# list_versions_rss). The feeds reject the v0 key above. Leave this commented
# out if you don't have one; the other tools don't need it.
# LEGISLATION_NZ_RSS_API_KEY=your_rss_key_here
