# Your legislation.govt.nz developer API key.
# Request one at: https://www.legislation.govt.nz/learn-more/legislation-data/developer-api/
LEGISLATION_NZ_API_KEY=your_api_key_here

# Optional: RSS-only key for the legacy feed tools (search_legislation_rss,
# list_versions_rss). The feeds reject the v0 key above. Leave this commented
# out if you don't have one; the other tools don't need it.
# LEGISLATION_NZ_RSS_API_KEY=your_rss_key_here

# --- HTTP server (dist/http.js, Docker) ---------------------------------------
# The address people reach the server at; used as the OAuth issuer. Origin only.
LEGISLATION_PUBLIC_URL=https://legislation.example.nz

# Who may log in: username:hash pairs, comma-separated. Make each entry with
#   node dist/auth/cli.js hash-password <username>
# (in Docker: docker compose run --rm legislation-mcp node dist/auth/cli.js hash-password <username>)
# Remove a user, or change their password, to end their logins.
LEGISLATION_AUTH_USERS=

# Optional: upstream API requests each user may make per NZ day (default 4000; 0 = no cap).
# LEGISLATION_DAILY_CAP_PER_USER=4000

# Optional: redirect URIs OAuth clients may register (default: claude.ai's callbacks).
# LEGISLATION_AUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Optional: login state file (default ./data/auth-state.json; /data/auth-state.json in Docker).
# LEGISLATION_AUTH_STATE=

# For local testing only: no login, and the server listens on 127.0.0.1 only.
# LEGISLATION_AUTH=off
